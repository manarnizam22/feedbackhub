# Copy to .env (gitignored). Values below are the dev defaults baked into
# docker-compose — override only what you need.

# PostgreSQL (dev instance; also hosts Keycloak's own database)
POSTGRES_USER=feedbackhub
POSTGRES_PASSWORD=feedbackhub-dev
POSTGRES_DB=feedbackhub

# Keycloak bootstrap admin — used on first boot of an empty Keycloak database only
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# Google sign-in. Create an OAuth 2.0 client at https://console.cloud.google.com
# (authorized redirect URI: http://localhost:8080/realms/feedbackhub/broker/google/endpoint)
# and paste its credentials here. The realm import wires them automatically.
# Without real values the Google button renders but Google rejects the flow.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
